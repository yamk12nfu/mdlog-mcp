{
  "name": "@yamk12nfu/mdlog-mcp",
  "version": "0.1.0",
  "description": "MCP server for searching date-organized markdown logs (daily digests, journals, notes)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mdlog-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "markdown",
    "digest",
    "journal",
    "notes",
    "search"
  ],
  "author": "yamk12nfu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamk12nfu/mdlog-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
